# Flask Dashboard Config
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080

# Hostapd Interface
HOSTAPD_IFACE=wlan0
HOSTAPD_CLI=/usr/sbin/hostapd_cli

# Hostapd Logs (Mehrere Pfade mit , oder ;)
HOSTAPD_LOG=/var/log/hostapd.log,/var/log/syslog

# Performance / Polling
MAX_LOG_LINES=5000
POLL_INTERVAL=5
HISTORY_MINUTES=120
